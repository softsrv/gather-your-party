# Externally hosted Postgres; keep the TLS settings required by your provider.
DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require
# Replace with a high-entropy secret; reserved for future session security.
SESSION_SECRET=replace-with-a-random-secret
# Public origin; reserved for future authentication callbacks.
APP_BASE_URL=http://localhost:8080
# Steam Web API key used for profile/game requests.
STEAM_API_KEY=replace-with-your-steam-api-key
# Port only (the server adds the colon).
LISTEN_ADDR=8080
