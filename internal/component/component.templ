package component

import (
	"strconv"

	"github.com/softsrv/steamapi/steamapi"
)

templ Navbar(player steamapi.Player, username string) {
	<div class="navbar bg-base-100">
		<div class="flex-1">
			<a class="btn btn-ghost text-xl" href="/">Gather Your Party</a>
		</div>
		<div class="flex-none">
			<ul class="menu menu-horizontal px-1">
				if player.PersonaName != "" {
					<li>
						<details>
							<summary>
								<img src={ player.AvatarSmall }/> { player.PersonaName }
							</summary>
							<ul class="p-2 bg-base-100 rounded-t-none">
								<li><a>profile</a></li>
								<li><form action="/auth/steam/logout" method="post"><button type="submit">log out</button></form></li>
							</ul>
						</details>
					</li>
				} else {
					<li><a href="/auth/steam">Login</a></li>
				}
			</ul>
		</div>
	</div>
}

templ LeaveConfirmation(partyID string) {
	<section id="leave-confirmation" aria-label="Leave party">
		<p>Are you sure you want to leave this party?</p>
		<form method="post" action={ templ.SafeURL("/parties/" + partyID + "/leave") } hx-post={ "/parties/" + partyID + "/leave" } hx-target="#leave-confirmation" hx-swap="outerHTML">
			<button type="submit" name="confirm" value="yes" class="btn btn-primary">Confirm</button>
			<a href="/" class="btn" onclick="this.closest('section').remove(); return false;">Cancel</a>
		</form>
	</section>
}

type StepDownCandidate struct {
	UserID int64
	Name   string
}

templ StepDownControl(partyID string, candidates []StepDownCandidate) {
	<section id="step-down-control" aria-label="Step down as leader">
		if len(candidates) == 0 {
			<p class="text-sm opacity-70">You are the only member of this party, so leadership cannot be handed off.</p>
		} else {
			<p>Hand off leadership to another member:</p>
			<form method="post" action={ templ.SafeURL("/parties/" + partyID + "/step-down") } hx-post={ "/parties/" + partyID + "/step-down" } hx-target="#step-down-control" hx-swap="outerHTML">
				for _, candidate := range candidates {
					<button type="submit" name="target" value={ strconv.FormatInt(candidate.UserID, 10) } class="btn btn-primary">{ candidate.Name }</button>
				}
			</form>
		}
	</section>
}

type InviteCandidate struct {
	UserID int64
	Name   string
}

templ InvitePicker(partyID string, candidates []InviteCandidate) {
	<section aria-label="Invite friends">
		if len(candidates) == 0 {
			<p class="text-sm opacity-70">No friends are available to invite.</p>
		} else {
			<form method="post" action={ templ.SafeURL("/parties/" + partyID + "/invites/send") } hx-post={ "/parties/" + partyID + "/invites/send" } hx-target="closest section" hx-swap="outerHTML">
				for _, candidate := range candidates {
					<button type="submit" name="target" value={ strconv.FormatInt(candidate.UserID, 10) } class="btn btn-primary">{ candidate.Name }</button>
				}
			</form>
		}
	</section>
}

templ AcceptInviteControl(partyID string) {
	<form method="post" action={ templ.SafeURL("/parties/" + partyID + "/invites/accept") } hx-post={ "/parties/" + partyID + "/invites/accept" } hx-target="this" hx-swap="outerHTML">
		<button type="submit" class="btn btn-primary">Accept invite</button>
	</form>
}

templ RejectInviteControl(partyID string) {
	<form method="post" action={ templ.SafeURL("/parties/" + partyID + "/invites/reject") } hx-post={ "/parties/" + partyID + "/invites/reject" } hx-target="this" hx-swap="outerHTML">
		<button type="submit" class="btn">Reject invite</button>
	</form>
}

templ Banner() {
	<header class="p-6 flex flex-col justify-between">
		<img src="/static/svg/logo.svg" class="h-20 w-20"/>
	</header>
}

templ Main() {
	<div class="mb-4">
		<div id="game-list">
			<button hx-target="#game-list" hx-get="/frag/games" class="btn btn-active btn-primary w-full flex justify-center text-gray-100 p-3  rounded-full tracking-wide font-semibold  shadow-lg cursor-pointer transition ease-in duration-200">
				Show Games
			</button>
			<button hx-target="#game-list" hx-get="/frag/friends" class="btn btn-active btn-primary w-full flex justify-center text-gray-100 p-3  rounded-full tracking-wide font-semibold  shadow-lg cursor-pointer transition ease-in duration-200">
				Show Friends
			</button>
		</div>
	</div>
}

templ TextAndTitle(title string, text string) {
	<div>
		<h1 class="text-lg font-bold">{ title }</h1>
		<p class="text-sm">{ text }</p>
	</div>
}

templ ErrorMessage(msg string) {
	@ErrorMessages([]string{msg})
}

templ ErrorMessages(msgs []string) {
	<div class="alert alert-error text-error-content" role="alert">
		<ul>
			for _, msg := range msgs {
				<li>{ msg }</li>
			}
		</ul>
	</div>
}

templ Signin() {
	<div class="min-h-screen sm:flex sm:flex-row mx-0 justify-center">
		<div class="flex-col flex  self-center p-10 sm:max-w-5xl xl:max-w-2xl  z-10">
			<div class="self-start hidden lg:flex flex-col  text-white">
				<h1 class="mb-3 font-bold text-5xl">Gather Your Party </h1>
				<p class="pr-3">
					log in here
				</p>
			</div>
		</div>
		<div class="flex justify-center self-center  z-10">
			<div class="p-12 bg-white mx-auto rounded-2xl w-100 ">
				<div class="mb-4">
					<h3 class="font-semibold text-2xl text-gray-800">Sign In </h3>
					<p class="text-gray-500">Sign in with your Steam account to continue.</p>
				</div>
				<div class="space-y-5">
					<a href="/auth/steam" class="btn btn-active btn-primary w-full flex justify-center text-gray-100 p-3 rounded-full tracking-wide font-semibold shadow-lg cursor-pointer transition ease-in duration-200">Sign in through Steam</a>
				</div>
				<div class="pt-5 text-center text-gray-400 text-xs">
					<span>
						Copyright © 2021-2022
						<a href="https://codepen.io/uidesignhub" rel="" target="_blank" title="Ajimon" class="text-green hover:text-green-500 ">AJI</a>
					</span>
				</div>
			</div>
		</div>
	</div>
}
