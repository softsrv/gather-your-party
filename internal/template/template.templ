package template

import "gather-your-party/internal/component"

import "github.com/softsrv/steamapi/steamapi"

type PageState int

const (
	Signin PageState = iota
	Main
)

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="tavern">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="color-scheme" content="dark"/>
			<link rel="icon" type="image/svg+xml" href="/static/svg/favicon.svg"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=Inter:wght@400..700&display=swap"/>
			<script src="/static/script/htmx.min.js"></script>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<title>{ title }</title>
		</head>
		<body class="min-h-screen">
			{ children... }
		</body>
	</html>
}

// Page is the shared chrome for full pages: navigation, content column, footer.
templ Page(title string, nav component.NavState) {
	@Base(title) {
		@component.Navbar(nav)
		<main class="mx-auto grid max-w-6xl gap-8 px-4 py-8 sm:px-6 sm:py-10">
			{ children... }
		</main>
		<footer class="mx-auto max-w-6xl px-4 pb-10 pt-4 text-xs text-base-content/40 sm:px-6">
			Gather Your Party · Not affiliated with Valve. Steam data comes from the Steam Web API.
		</footer>
	}
}

templ Home(player steamapi.Player, title string, pageName PageState) {
	@Page(title, component.NavState{Player: player, SignedIn: pageName == Main, Active: "home"}) {
		if pageName == Signin {
			@component.Signin()
		} else if pageName == Main {
			@component.Dashboard(player)
		} else {
			@component.TextAndTitle("thank you", "welcome to the site")
		}
	}
}

templ ErrorPage(title string, msg string) {
	@Page(title, component.NavState{SignedIn: true}) {
		@component.PageHeader("", "Something went wrong", "We couldn't load this page from Steam. Try again in a moment.")
		@component.ErrorMessage(msg)
	}
}

templ PartiesPage(player steamapi.Player, parties []component.UserParty, invites []component.UserPendingInvite) {
	@Page("Parties", component.NavState{Player: player, SignedIn: true, Active: "parties"}) {
		@component.PageHeader("Your parties", "Parties", "The groups you game with. Open a party to see who's in it and invite friends.")
		<div class="grid items-start gap-6 lg:grid-cols-[1fr_22rem]">
			@component.PartiesTabs(parties, invites)
			@component.CreatePartyForm()
		</div>
	}
}

templ PartyDetail(player steamapi.Player, partyID string, partyName string, members []component.PartyMember, isLeader bool, inviteCandidates []component.InviteCandidate, stepDownCandidates []component.StepDownCandidate, sharedGames []component.SharedGameCount, gamesMessages []string) {
	@Page("Party details", component.NavState{Player: player, SignedIn: true, Active: "parties"}) {
		<div class="space-y-4">
			<a href="/parties" class="btn btn-ghost btn-sm -ml-3 gap-2 text-base-content/60">
				@component.Icon("arrow-left", "h-4 w-4")
				All parties
			</a>
			<div class="flex flex-wrap items-center gap-3">
				<h1 class="text-3xl font-extrabold sm:text-4xl">
					if partyName != "" {
						{ partyName }
					} else {
						Your party
					}
				</h1>
				if isLeader {
					<span class="badge badge-primary gap-1 py-3">
						@component.Icon("crown", "h-3.5 w-3.5")
						You lead this party
					</span>
				}
			</div>
		</div>
		<div class="grid items-start gap-6 lg:grid-cols-[1fr_22rem]">
			<div class="grid gap-6">
				@component.PartyRoster(members)
				<section aria-label="Shared games" class="space-y-4">
					<h2 class="text-lg font-bold">Shared games</h2>
					if len(gamesMessages) > 0 {
						@ErrorMessages(gamesMessages)
					} else {
						@component.SharedGamesWithCounts(sharedGames)
					}
				</section>
			</div>
			<div class="grid gap-6">
				if isLeader {
					@component.InvitePicker(partyID, inviteCandidates)
					@component.StepDownControl(partyID, stepDownCandidates)
				}
				@component.LeavePartyLink(partyID)
			</div>
		</div>
	}
}

templ LeaveParty(player steamapi.Player, partyID string) {
	@Page("Leave party", component.NavState{Player: player, SignedIn: true, Active: "parties"}) {
		<div class="py-6 sm:py-12">
			@component.LeaveConfirmation(partyID)
		</div>
	}
}

templ ErrorMessage(msg string) {
	@component.ErrorMessage(msg)
}

templ ErrorMessages(msgs []string) {
	@component.ErrorMessages(msgs)
}

templ GameList(games []steamapi.Game) {
	@component.Library(games)
}

templ SharedGamesList(games []steamapi.Game) {
	@component.SharedGames(games)
}

templ FriendsList(friends []steamapi.Player) {
	@component.FriendPicker(friends)
}
